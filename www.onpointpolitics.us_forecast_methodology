n\":[\"$\",\"$Lf\",null,{\"href\":\"/results/tonight\",\"children\":\"Live desk\"}]}],[\"$\",\"li\",\"/results/archiveArchive\",{\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/results/archive\",\"children\":\"Archive\"}]}],[\"$\",\"li\",\"/maps/electoralElectoral map\",{\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/maps/electoral\",\"children\":\"Electoral map\"}]}],[\"$\",\"li\",\"/maps/party-registrationParty registration\",{\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/maps/party-registration\",\"children\":\"Party registration\"}]}],[\"$\",\"li\",\"/maps/early-voteEarly vote\",{\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/maps/early-vote\",\"children\":\"Early vote\"}]}]]}]]}]\n22:[\"$\",\"div\",\"On Point Polling\",{\"children\":[[\"$\",\"h4\",null,{\"children\":\"On Point Polling\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",\"/on-point-pollingAbout\",{\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/on-point-polling\",\"children\":\"About\"}]}],[\"$\",\"li\",\"/on-point-polling/pollsPoll releases\",{\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/on-point-polling/polls\",\"children\":\"Poll releases\"}]}],[\"$\",\"li\",\"/on-point-polling/servicesPartner with us\",{\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/on-point-polling/services\",\"children\":\"Partner with us\"}]}],[\"$\",\"li\",\"/on-point-polling/weighting-roomThe Weighting Room\",{\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/on-point-polling/weighting-r"])</script><script>self.__next_f.push([1,"oom\",\"children\":\"The Weighting Room\"}]}],[\"$\",\"li\",\"/portal/loginClient portal\",{\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/portal/login\",\"children\":\"Client portal\"}]}],[\"$\",\"li\",\"/contactContact\",{\"children\":[\"$\",\"$Lf\",null,{\"href\":\"/contact\",\"children\":\"Contact\"}]}]]}]]}]\n23:[\"$\",\"div\",null,{\"className\":\"bottom\",\"children\":[[\"$\",\"span\",null,{\"children\":\"© 2026 On Point Politics and On Point Polling\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"$Lf\",null,{\"href\":\"/terms\",\"children\":\"Terms\"}],\" · \",[\"$\",\"$Lf\",null,{\"href\":\"/terms#privacy\",\"children\":\"Privacy\"}],\" · \",[\"$\",\"$Lf\",null,{\"href\":\"/on-point-polling/sms\",\"children\":\"SMS opt in\"}]]}]]}]\n26:[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"The forecast rebuilds every 2026 Senate, governor and House race county by county. It starts from what the fundamentals say a race should look like, moves that toward the polling average as the polling gets deeper and the election gets closer, adjusts for the candidates, and then runs the whole election 2,000 times with shared errors so that races move together the way they do on a real election night.\"}],[\"$\",\"p\",null,{\"children\":\"Each race carries three legs. The first is a fundamentals leg built from On Point Polling county by county presidential approval. The second takes each county’s certified 2024 result and moves it by the demographic swing to the 2026 national environment. The third carries each county’s own voting history, and its statewide level is the polling average. The three are blended into one county forecast, which is then simulated.\"}]]}]\n"])</script><script>self.__next_f.push([1,"27:[\"$\",\"section\",\"fundamentals\",{\"id\":\"fundamentals\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Fundamentals\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Step 1\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Partisan lean.\"}],\" Every state, county and district starts from its presidential lean on the lines in force for 2026, taken from the certified results. On the race pages this is the anchor, the first stage in the breakdown of how the number gets made.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"National environment.\"}],\" The 2026 environment comes from the generic congressional ballot and presidential approval. The generic ballot sets the national vote, and the On Point Polling respondent database supplies approval county by county, calibrated and converted into vote with the On Point Polling respondent crosstabs. Each county responds to the environment through its own elasticity, estimated from a national demographic fit and its own recent presidential swings, so a swing county moves more than a county that votes the same way every cycle.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Incumbency.\"}],\" An incumbent carries a measured personal vote: the county by county gap between that person’s own past races and the nearest presidential race on the same ground. It applies to every sitting governor on the ballot and to none of the open seats. An incumbent who never won the office has no personal vote to carry.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"28:[\"$\",\"section\",\"polls\",{\"id\":\"polls\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"The polling average\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Step 2\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Every poll of a race enters the average once. A poll’s weight is the product of its sample size, its age, its voter screen, its pollster grade and a penalty for a large undecided share. Recency decays over about three weeks, so a poll fielded a month ago counts for a fraction of one fielded this week. Likely voter samples count three times as much as registered voter samples, and adult samples count very little. Repeated releases from the same pollster inside three weeks are discounted, so one house cannot swamp the average, and any poll more than two standard deviations from the rest is pulled back to that line.\"}],[\"$\",\"p\",null,{\"children\":\"Where a race has 8 or more polls, the level comes from a LOWESS trend instead. Every poll is placed at the midpoint of its field dates, published averages are left out, and a robust LOWESS line is fit at three spans. The Election Day level is 40 percent of the recent trend plus 60 percent of the long term trend, carried flat from the newest poll. That blend missed later polling the least in a backtest of the site’s own polls. The weighted average still supplies the decided share and the third party share, so only the split of the decided vote moves. Races with fewer than 8 polls keep the weighted average.\"}],[\"$\",\"p\",null,{\"children\":[\"Pollster grades come from the \",[\"$\",\"$Lf\",null,{\"href\":\"/on-point-polling/methodology\",\"children\":\"On Point Polling pollster ratings\"}],\", and polls sponsored by a campaign or a party are flagged on every race page.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"29:[\"$\",\"section\",\"blend\",{\"id\":\"blend\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"How polls and fundamentals blend\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Step 3\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"The weight on the polling leg grows with how much independent polling a race has, counted in distinct nonpartisan polling houses rather than in polls, so three surveys from one pollster do not read as three reads of the race. Houses that polled inside 45 days count in full and houses that polled 45 to 60 days out count half. The weight rises in a straight line from one house to eight.\"}],[\"$\",\"p\",null,{\"children\":\"The ceiling on that weight also rises as Election Day approaches, because a poll’s information about the final margin climbs over the last six weeks while the fundamentals stop learning. At five weeks out the polling leg carries a little over 40 percent of the blend with one polling house and a little under 80 percent with eight or more. A race with no polls gives the three legs equal weight, and the blend then collapses to half fundamentals and half 2024 baseline.\"}]]}]]}]\n2a:[\"$\",\"section\",\"candidates\",{\"id\":\"candidates\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Candidate effects\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Step 4\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Beyond incumbency, the model prices the candidates themselves. Party unity comes from each nominee’s share of their own party’s 2026 primary vote, so a nominee who limped out of a divided primary carries less of their party. Where a race’s own polling sits away from the model’s fundamentals, that gap is read as candidate strength. In governor races with little or no polling, a small campaign finance term uses verified individual contributions, net of self funding, and it stands down wherever real polling exists.\"}],[\"$\",\"p\",null,{\"children\":\"Third party and independent candidates are modeled explicitly rather than folded into the major parties. Where an independent is the main challenger, as in Nebraska, that candidate takes the non Republican side of the race and is shown in lavender.\"}]]}]]}]\n3c:T843,"])</script><script>self.__next_f.push([1,"Local conditions compound. A county’s terms, jobs, wages, tariff exposure, population growth, migration, faith, rurality, news deserts, data centers and the gas rise through financial strain, each keep the direction their fit gave them. A term counts as active when it sits at least half a standard deviation of its national spread from zero, and when the active terms line up the county’s whole local term is multiplied by e to the 0.15 k, where k is the active terms pushing the county’s way less those pushing the other way, less one, held at six times. Counties with more local news feel their conditions more, by e to the 0.25 z on their log local news outlets per 100,000 residents against the nation, about 0.6 times in a news desert and about 1.65 times in the best covered places. A county’s combined term is held only within about 46 points of margin, a safety limit, and a county may run 0.15 in log odds past the edge of its own historical lean; the county term counts 2.0 times and the statewide part 1.25 times. Gas is fair and adds no tilt: every county is read against the national price rise since October 2025 both ways, a county whose rise ran above the nation’s moving toward Democrats through voters who call their finances difficult and one whose rise ran below it moving the same distance the other way, so the national total is zero; an extra dollar of rise counts what an extra dollar of price does in the On Point Polling fit. These terms are built into the legs rather than laid over the finished forecast: their county pattern is part of every leg’s county shape, the poll leg included and then set back to the polling average, and their statewide part enters only the approval, Gallup and seat history legs, since the polls already carry each state’s conditions. The polls weigh more as they pile up: the Gallup floor is 40 percent with four or fewer polls in the last 60 days and falls in a straight line to 15 percent at 24, the poll weight can reach 90 percent, and House district polls count at 0.80 of the blend with an incumbent running and 0.88 in an open district."])</script><script>self.__next_f.push([1,"2b:[\"$\",\"section\",\"local\",{\"id\":\"local\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Local conditions, gas, data centers and coalitions\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Step 4b\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Gallup party identification runs at full strength as its own leg of every Senate and governor forecast, at least 40 percent of the blend and 60 percent of each state’s House fundamentals level: each county’s certified 2024 vote is moved by the On Point Polling demographic swing and by its own elasticity to Gallup’s 50 Democratic to 39 Republican. Applied the same way, Gallup’s third quarter 2025 reading called Virginia’s and New Jersey’s 2025 governor races within about a point, where the final polling averages were 5 to 10 points short. Those were open seats, so where an incumbent governor is running the Gallup leg follows the national environment at 0.6 like the other legs, and in a governor race with 10 or more polls its floor is 30 percent.\"}],[\"$\",\"p\",null,{\"children\":\"Gas counts by how much prices have risen since October 2025, not by how high they are. Each county’s rise is its AAA price today against a year earlier, through the nearest metro’s change within 50 kilometers or its state’s: about $1.27 a gallon nationally, from about 91 to 93 cents in Oregon, North Carolina and Georgia to $1.71 in Michigan. Everyone is paying more, and that national rise is already in the polls; the term says where the squeeze is worst. In counties with the steepest rise, Trump 2024 voters who call their finances difficult move toward Democrats and strained Harris voters hold, at 0.6 of the size fitted on the On Point Polling data.\"}],[\"$\",\"p\",null,{\"children\":\"Data centers have their own term. The Economist and YouGov track the generic ballot by distance to the nearest data center, and people within 2 kilometers now vote 6.3 points more Democratic than people farther away, up from almost no gap in January 2025. The model moves the voters of each ZIP code near an operating or planned site by three quarters of that measured gap, carried to counties and districts, with governors at 1.15 times since siting and power rates are state decisions. In governor races the statewide data center and gas pushes together are held within 2 points.\"}],[\"$\",\"p\",null,{\"children\":\"$3c\"}],\"$L3d\",\"$L3e\"]}]]}]\n"])</script><script>self.__next_f.push([1,"2c:[\"$\",\"section\",\"sims\",{\"id\":\"sims\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"2,000 correlated simulations\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Step 5\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Each county’s electorate is rebuilt from census cells by age, race and college education, split further by party and 2022 vote history, with every group given its own chance of turning out and its own vote. Constants are solved so the groups reproduce each county’s projected turnout and two party share exactly. Then the election is run 2,000 times. In every run:\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"a \",[\"$\",\"b\",null,{\"children\":\"national shock\"}],\", shared by every race in that run, moves the whole country together, scaled in each county by its elasticity;\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"demographic shocks\"}],\", also shared nationally, move each group’s vote and turnout together everywhere that group lives, and voters who skipped 2022 surge or stay home together;\"]}],[\"$\",\"li\",null,{\"children\":[\"a \",[\"$\",\"b\",null,{\"children\":\"state shock\"}],\" moves each state on its own, sized by the polling on file: widest with no polls and narrowest with four or more;\"]}],[\"$\",\"li\",null,{\"children\":[\"a \",[\"$\",\"b\",null,{\"children\":\"county shock\"}],\" that shrinks with county size, plus turnout, enthusiasm and third party shocks;\"]}],[\"$\",\"li\",null,{\"children\":\"then every group’s voters are drawn: how many turn out, how many vote third party, and how the rest split.\"}]]}],[\"$\",\"p\",null,{\"children\":\"Because the national and demographic shocks are shared, a bad night for one party in Michigan is also a bad night for that party in Wisconsin and Pennsylvania. Win probabilities, the 80 percent range of each margin and the chamber odds all come from the same 2,000 runs.\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"3f:T41e,The gap is not taken at face value. Ballots cast early in the window run more Democratic than the early vote as a whole, so the reading is moved toward Republicans by how much of the early vote is still to come. Where a state published the party split of its early vote on the same day and at the close in 2022 or 2024, the like for like comparison, today against that day, less the forecast's expected early vote against that year's final, carries most of the weight. Only part of the electorate has voted: the ballots in carry the whole gap, and the ballots still to come carry half of it. The reading counts more with more ballots and more of the early vote in, and less where party is estimated rather than reported. Turnout volume against the early vote the forecast expects by this day, timed by each state's own 2022 and 2024 counts, reads whether the electorate is running larger or smaller. Primary turnout, the Democratic share of 2026 primary ballots against the 2018 and 2022 midterm primaries, is a weak prior on which party is more engaged."])</script><script>self.__next_f.push([1,"2d:[\"$\",\"section\",\"early-vote\",{\"id\":\"early-vote\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"The early vote, as a turnout correction\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Step 6\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"Once ballots start coming in, the forecast reads them as a check on turnout. In every state that reports early ballots, the party mix of the mail and in person ballots cast so far, as reported or, where a state reports no party, as estimated on the \",[\"$\",\"$Lf\",null,{\"href\":\"/maps/early-vote\",\"style\":{\"textDecoration\":\"underline\"},\"children\":\"early vote tracker\"}],\", is set against the party mix the forecast's own 2026 electorate expected of those ballots.\"]}],[\"$\",\"p\",null,{\"children\":\"$3f\"}],[\"$\",\"p\",null,{\"children\":\"Every state then also reads the states most like it, by the model's own correlation between races and by 2024 vote, race and education, so a state with no early vote yet takes its correction from similar states and its primary. The forecast is the prior throughout: a thin early vote barely moves a race.\"}],[\"$\",\"p\",null,{\"children\":\"The correction is not a flat shift. It becomes a change in each party's turnout among the forecast's simulated voters, the 1,152 kinds of voter in every county, and each race is recounted. Turnout is a logistic curve, so the same change moves low propensity voters far more than habitual ones: a race whose margin rests on one party's low propensity voters moves more, and every county moves by its own voters. House districts take their state's correction in proportion to how close their own vote is, so a safe seat moves less than a competitive one, and the statewide offices and legislatures are rebuilt on the adjusted forecast. Each race page shows the correction as its own step.\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"2e:[\"$\",\"section\",\"governors\",{\"id\":\"governors\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Governor depolarization\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Governors\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Governor races are more local than Senate races. On the certified results of 108 governor races in 2014, 2018 and 2022, the governor vote followed the state’s presidential lean and the national House environment at only about half strength, while Senate races followed the presidential lean almost one for one.\"}],[\"$\",\"p\",null,{\"children\":\"So governor races respond to about 60 percent of the national swing and 60 percent of the state’s partisan lean against the nation, a beta of 0.6 and a lambda of 0.6. The fundamentals keep their county pattern, but their statewide level moves by that much less. In the simulations, governor races take 60 percent of the shared national and demographic vote shocks, and the rest becomes their own state level uncertainty. Turnout shocks stay national, since governors share the ballot and the electorate with the Senate.\"}],[\"$\",\"p\",null,{\"children\":\"Leaving one cycle out at a time, the fully partisan baseline missed by 19.5 points of margin on average and called 82.1 percent of winners. At 0.6 the miss fell to 15.0 points and 84.9 percent of winners were called. 0.6 is the conservative end of the range that helps, because the model already measures each incumbent’s personal vote and reads the polls. Senate races are untouched.\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"2f:[\"$\",\"section\",\"counties\",{\"id\":\"counties\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"County simulations\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Maps\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[\"$\",\"p\",null,{\"children\":\"County results on the maps are the average of the simulated votes in that county across all 2,000 runs, and statewide results are the sum of the counties. Hover any county on a race page for its simulated margin and simulated vote. The estimated exit poll on each statewide page is read the same way, off the simulated voters grouped by age, race, education, party and vote history, not asked of anyone.\"}]}]]}]\n30:[\"$\",\"section\",\"house\",{\"id\":\"house\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"The House district model\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"House\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[\"$\",\"p\",null,{\"children\":\"The House runs the same machinery, district by district. Each district starts from its 2024 presidential result on the lines in force for 2026, then adds its incumbent and any redrawing, measured ticket splitting, turnout in its own primary, district polls where they exist, FEC money, top two and one party generals, and unopposed seats. Each district’s electorate is rebuilt from the voter groups of the counties that look like it, and the election is run 2,000 times with the same national, demographic and irregular voter shocks as the Senate and governor runs, so the House, the Senate and the governors move together in every run.\"}]}]]}]\n"])</script><script>self.__next_f.push([1,"31:[\"$\",\"section\",\"chambers\",{\"id\":\"chambers\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"How chamber odds are counted\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Control\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"In every simulation the model counts the seats each party wins, adds the seats not on the 2026 ballot, and checks who controls the chamber. The odds are the share of the 2,000 runs each party ends up in control.\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Senate:\"}],\" Democrats need 51 of 100 seats, because a 50 to 50 chamber stays Republican on the Vice President’s tiebreak. The 34 Democratic and 31 Republican seats not up this year are counted in. Dan Osborn in Nebraska is counted in the Democratic column.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"House:\"}],\" 218 of 435 seats.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"b\",null,{\"children\":\"Governors:\"}],\" a majority of all 50 governorships, 26, counting the 14 not on this year’s ballot.\"]}]]}],[\"$\",\"p\",null,{\"children\":\"The seat bar on the forecast page calls every race for its projected winner. That is a different number from the average seat count across the simulations, which leans toward whichever side holds more of the close seats. Both are shown.\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"32:[\"$\",\"section\",\"ratings\",{\"id\":\"ratings\",\"className\":\"card fm-sec\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Rating bands\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Ratings\"}]]}],[\"$\",\"div\",null,{\"className\":\"card-b fm-prose\",\"children\":[\"$\",\"p\",null,{\"children\":\"Every race gets a rating from its model margin. A race inside 2 points is a toss up. From 2 to 6 points it leans to the leader, from 6 to 12 it is likely, and at 12 points or more it is safe. Where the leading non Republican candidate is an independent, the race is shown in the independent lavender. The same bands color the maps, pale for close races and deep for safe ones.\"}]}]]}]\n"])</script><script>self.__next_f.push([1,"33:[\"$\",\"aside\",null,{\"className\":\"side fm-side\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[\"$\",\"h3\",null,{\"children\":\"On this page\"}]}],[\"$\",\"nav\",null,{\"className\":\"card-b fm-toc\",\"aria-label\":\"Sections\",\"children\":[[\"$\",\"a\",\"overview\",{\"href\":\"#overview\",\"children\":\"What the model does\"}],[\"$\",\"a\",\"fundamentals\",{\"href\":\"#fundamentals\",\"children\":\"Fundamentals\"}],[\"$\",\"a\",\"polls\",{\"href\":\"#polls\",\"children\":\"The polling average\"}],[\"$\",\"a\",\"blend\",{\"href\":\"#blend\",\"children\":\"How polls and fundamentals blend\"}],[\"$\",\"a\",\"candidates\",{\"href\":\"#candidates\",\"children\":\"Candidate effects\"}],[\"$\",\"a\",\"local\",{\"href\":\"#local\",\"children\":\"Local conditions, gas, data centers and coalitions\"}],[\"$\",\"a\",\"sims\",{\"href\":\"#sims\",\"children\":\"2,000 correlated simulations\"}],[\"$\",\"a\",\"early-vote\",{\"href\":\"#early-vote\",\"children\":\"The early vote, as a turnout correction\"}],[\"$\",\"a\",\"governors\",{\"href\":\"#governors\",\"children\":\"Governor depolarization\"}],[\"$\",\"a\",\"counties\",{\"href\":\"#counties\",\"children\":\"County simulations\"}],[\"$\",\"a\",\"house\",{\"href\":\"#house\",\"children\":\"The House district model\"}],[\"$\",\"a\",\"chambers\",{\"href\":\"#chambers\",\"children\":\"How chamber odds are counted\"}],[\"$\",\"a\",\"ratings\",{\"href\":\"#ratings\",\"children\":\"Rating bands\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"card\",\"children\":[[\"$\",\"div\",null,{\"className\":\"card-h\",\"children\":[[\"$\",\"h3\",null,{\"children\":\"Rating bands\"}],[\"$\",\"span\",null,{\"className\":\"eye\",\"style\":{\"marginLeft\":\"auto\"},\"children\":\"Model m